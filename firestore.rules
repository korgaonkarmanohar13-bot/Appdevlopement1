rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == uid
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 16)
        && (!('bestScore' in request.resource.data) || request.resource.data.bestScore is number);
    }
    match /runs/{id} {
      allow create: if request.auth.uid == request.resource.data.uid
        && request.resource.data.score is int && request.resource.data.score >= 0;
      allow read: if false;
    }
    match /config/{doc} { allow read: if true; allow write: if false; }
  }
}
